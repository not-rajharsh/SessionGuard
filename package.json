{
  "name": "session-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Session-hijacking defense: demo app, risk engine, attack demo (Phase 1: core detection)",
  "scripts": {
    "setup": "python3 -m venv risk-engine/.venv && risk-engine/.venv/bin/pip install -r risk-engine/requirements.txt && npm install && npx playwright install chromium",
    "app": "node demo-app/server.js",
    "engine": "node scripts/engine.js",
    "attack": "node attack/attack.js",
    "demo": "node scripts/demo.js",
    "console": "node scripts/console.js",
    "test": "npm run test:py && npm run test:js && npm run test:browser",
    "test:js": "node --test --test-concurrency=1 \"demo-app/test/*.test.js\"",
    "test:py": "cd risk-engine && .venv/bin/python -m pytest -q",
    "test:browser": "node --test --test-concurrency=1 \"browser-tests/*.test.js\"",
    "register-passkey": "node scripts/register-passkey.js",
    "netsim": "node scripts/netsim.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "connect-redis": "7.1.1",
    "express": "4.21.2",
    "express-session": "1.18.1",
    "playwright": "1.64.1",
    "redis": "4.7.0"
  }
}
