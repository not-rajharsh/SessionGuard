# Copy to .env (or just run `npm run demo`, which creates/upgrades one with random secrets).
# Blank secrets are refused at startup; nothing is hardcoded in source.

# Demo account (the single hardcoded user lives here, not in code)
DEMO_USER=demo
DEMO_PASSWORD=

# Admin dashboard (/admin) has its own login. Blank password = dashboard disabled.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Secrets shared by the app / engine
SESSION_SECRET=
ENGINE_API_KEY=

# Ports and endpoints
APP_PORT=3000
ENGINE_PORT=8000
NETSIM_PORT=3001
REDIS_URL=redis://127.0.0.1:6379/0
RISK_ENGINE_URL=http://127.0.0.1:8000

# A1: X-Forwarded-For is IGNORED unless the TCP peer is listed here.
# Comma-separated proxy IPs/CIDRs (or loopback). Blank = trust nobody (default).
# Hop counts and "true" are not accepted. `npm run demo` sets "loopback" itself for its edge simulator.
TRUST_PROXY=

# Demo-only: never tell an attacker which signals fired in production.
EXPOSE_SIGNALS=true

# B: refuse logins that don't bind a browser device key (set false only for non-browser tooling).
REQUIRE_DEVICE_KEY=true

# C: WebAuthn needs localhost or HTTPS. Origins default to http://localhost:$APP_PORT.
WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGINS=http://localhost:3000,http://localhost:3001

# D: LLM rationales. provider = muse (default) | ollama (local Llama) | openai_compatible (any OpenAI-compatible API) | template (no LLM).
# Each returns {text, provider, model, latency_ms}. Try in order on timeout/error if LLM_FALLBACK_CHAIN is set.
# Muse defaults: https://api.meta.ai/v1 + muse-spark-1.1 (OpenAI-style /chat/completions).
# Ollama defaults: http://localhost:11434/v1 + llama3.1. openai_compatible requires LLM_MODEL.
# If Muse returns empty text, it retries with double max_tokens and reasoning_effort=minimal.
LLM_PROVIDER=muse
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=5
LLM_MAX_TOKENS=512
LLM_REASONING_EFFORT=
LLM_FALLBACK_CHAIN=

# Demo console (/demo): served only when this is exactly "true", and only to localhost.
# `npm run console` sets it for you; leave it false for anything else. Also gates the engine's layer switches.
DEMO_MODE=false
